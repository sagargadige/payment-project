# ============================================================
#  PayPal Payment Gateway — Backend Environment Variables
#  ----------------------------------------------------------
#  1. Copy this file:      cp .env.example .env
#  2. Fill in YOUR OWN values (see README.md for how to get them)
#  3. NEVER commit the real .env file (it is git-ignored)
# ============================================================

# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# ---------- MongoDB ----------
# Local MongoDB:   mongodb://127.0.0.1:27017/paypal_gateway
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/paypal_gateway
MONGODB_URI=mongodb://127.0.0.1:27017/paypal_gateway

# ---------- Auth ----------
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- PayPal ----------
# sandbox  -> uses https://api-m.sandbox.paypal.com
# live     -> uses https://api-m.paypal.com
PAYPAL_MODE=sandbox

# From https://developer.paypal.com/dashboard/applications  (Sandbox tab for sandbox)
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET

# Webhook ID — created in the PayPal Developer Dashboard (see README "Webhooks")
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID

# ---------- Business / receiving account ----------
# The PayPal account that RECEIVES the money.
#   * sandbox mode -> your Business sandbox test account (e.g. sb-business@business.example.com)
#   * live mode    -> the real receiving account: chandraniyash11-1@oksbi
PAYPAL_RECEIVING_ACCOUNT=chandraniyash11-1@oksbi

# ---------- Frontend URL (used for PayPal return / cancel URLs) ----------
FRONTEND_URL=http://localhost:5173
